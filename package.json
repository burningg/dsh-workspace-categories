{
  "name": "@burningg/dsh-workspace-categories",
  "version": "2.0.0",
  "type": "module",
  "description": "Category groups for DeepSeek Harness workspaces — group the flat project list into named sections, and jump between recent chats with Ctrl+Tab.",
  "icon": "./icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "burningg",
  "homepage": "https://github.com/burningg/dsh-workspace-categories",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burningg/dsh-workspace-categories.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "workspace",
    "categories",
    "shortcut",
    "recent-chats"
  ],
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bugs": {
    "url": "https://github.com/burningg/dsh-workspace-categories/issues"
  }
}
